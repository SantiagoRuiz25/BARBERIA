# ======================================================
# Estudio 4-4-4 Barber — configuración del servidor (npm run api)
# Copia este archivo como  .env  y completa tus datos.
# NUNCA subas el archivo .env a GitHub ni lo compartas.
# ======================================================

# --- Panel del barbero (cámbialos antes de publicar) ---
ADMIN_EMAIL=erick@barberia444.com
ADMIN_PASS=pon-aqui-una-contrasena-larga
ADMIN_NAME=Adian Anave
TOKEN_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# --- Pagos en línea con Wompi (https://comercios.wompi.co) ---
# Dashboard de Wompi → Desarrolladores → Llaves.
# Para PROBAR usa las llaves de pruebas (pub_test_..., test_integrity_..., test_events_...).
# Para cobrar de verdad usa las de producción (pub_prod_...).
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Opcionales ---
# Dirección pública de tu página (necesaria al publicar), sin "/" al final
# PUBLIC_URL=https://tubarberia.com
# Porcentaje de la seña que se cobra en línea (por defecto 50)
# DEPOSIT_PERCENT=50
# Minutos que se retiene la hora mientras el cliente paga (por defecto 15)
# HOLD_MINUTES=15
# Carpeta donde se guardan las citas (apunta a un disco PERSISTENTE al publicar)
# DATA_DIR=/var/data
# Ponlo en 1 si el servidor está detrás de un proxy (Render, Railway, Nginx...)
# TRUST_PROXY=1
# PORT=3000
# NODE_ENV=production
